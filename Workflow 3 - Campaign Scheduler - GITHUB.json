      "name": "Get Campaign Sequence of Due Leads"
    },
    {
      "parameters": {
        "jsCode": "const dueLeads = $('Identify Due Leads').all();\n\nreturn items.map((item, index) => {\n  const lead = dueLeads[index].json;\n\n  return {\n    json: {\n      row_number: lead['row_number'],\n      leadId: lead['Lead ID'],\n      firstName: lead['First Name'],\n      lastName: lead['Last Name'],\n      email: lead['Email'],\n      company: lead['Company'],\n      jobTitle: lead['Job Title'],\n      linkedInURL: lead['LinkedIn URL'],\n      phone: lead['Phone'],\n\n      campaign: item.json['Campaign'],\n      step: item.json['Step'],\n      action: item.json['Action'],\n      wait: item.json['Wait'],\n      waitUnit: item.json['Wait Unit'],\n      status: item.json['Status'],\n      nextAction: item.json['Next Action'],\n      nextWait: item.json['Next Wait'],\n      nextWaitUnit: item.json['Next Wait Unit'],\n      subject: item.json['Subject'],\n      emailbody: item.json['Email Body']\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0
      ],
      "name": "Prepare Due Lead Actions"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.emailbody }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1120,
        0
      ],
      "name": "Send a message"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const lead = item.json;\n\n  let nextActionAt = null;\n\n  if (lead.nextAction !== 'Sequence Completed') {\n    const wait = Number(lead.nextWait) || 0;\n    const now = new Date();\n\n    if (lead.nextWaitUnit === 'Days') {\n      nextActionAt = new Date(\n        now.getTime() + wait * 24 * 60 * 60 * 1000\n      ).toISOString();\n    } else if (lead.nextWaitUnit === 'Hours') {\n      nextActionAt = new Date(\n        now.getTime() + wait * 60 * 60 * 1000\n      ).toISOString();\n    } else if (lead.nextWaitUnit === 'Minutes') {\n      nextActionAt = new Date(\n        now.getTime() + wait * 60 * 1000\n      ).toISOString();\n    }\n  }\n\n  return {\n    json: {\n      row_number: lead.row_number,\n      leadId: lead.leadId,\n\n      currentStep: Number(lead.step) + 1,\n      status: lead.status,\n      lastActivity: new Date().toISOString(),\n      nextAction: lead.nextAction,\n      nextActionAt,\n\n      gmailMessageId: lead.id,\n      gmailThreadId: lead.threadId\n    }\n  };\n});"
      },
