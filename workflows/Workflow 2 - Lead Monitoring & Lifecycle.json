        "jsCode": "const now = new Date();\nconst inactivityDays = 30;\n\nreturn items.map(item => {\n  const lead = item.json;\n\n  const lastActivity = new Date(lead['Last Activity']);\n\n  const daysSinceActivity =\n    (now - lastActivity) / (1000 * 60 * 60 * 24);\n\n  lead.daysSinceActivity = Math.floor(daysSinceActivity);\n  lead.isInactive = daysSinceActivity >= inactivityDays;\n\n  return item;\n});"
      },
