    {
      "parameters": {
        "jsCode": "// Get the leads that came in through the trigger\nconst incomingItems = $(\"Google Sheets Trigger\").all();\n\n// Get the current, fresh rows from Google Sheets\nconst rows = $input.all();\n\nconst results = [];\n\nfor (const incomingItem of incomingItems) {\n  const incoming = incomingItem.json;\n\n  const incomingEmail = String(\n    incoming.Email ?? \"\"\n  ).trim().toLowerCase();\n\n  let matchingRows = [];\n\nif (incomingEmail) {\n  matchingRows = rows.filter(item => {\n    const email = String(\n      item.json.Email ?? \"\"\n    ).trim().toLowerCase();\n\n    return email === incomingEmail;\n  });\n}\n\n\n  const isDuplicate = matchingRows.length > 1;\n\n  // Use the CURRENT database row as the lead record\n  // rather than the stale trigger record.\n  const lead = matchingRows[0]?.json ?? incoming;\n\n  results.push({\n    json: {\n      ...lead,\n      duplicate: isDuplicate,\n      incomingEmail,\n      matchingRows: matchingRows.map(row => ({\n        row_number: row.json.row_number,\n        email: row.json.Email\n      })),\n      duplicateRow: isDuplicate\n        ? matchingRows.find(\n            row => row.json.row_number !== lead.row_number\n          )?.json ?? null\n        : null\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
