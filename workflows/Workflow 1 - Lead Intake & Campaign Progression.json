    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const lead = item.json;\n\n  const email = String(lead['Email'] || '').trim();\n  const status = String(lead['Status'] || '').trim().toLowerCase();\n\n  let isEligible = true;\n  let eligibilityReason = 'Eligible';\n\n  // Lead must have an email address for the current email campaigns\n  if (!email) {\n    isEligible = false;\n    eligibilityReason = 'Missing email address';\n  }\n\n  // Do not re-enter leads who have opted out\n  else if (status === 'do not contact') {\n    isEligible = false;\n    eligibilityReason = 'Do Not Contact';\n  }\n\n  // Do not re-enter leads that are already inactive\n  else if (status === 'inactive') {\n    isEligible = false;\n    eligibilityReason = 'Lead is inactive';\n  }\n\n  // Do not restart completed sequences\n  else if (status === 'sequence completed') {\n    isEligible = false;\n    eligibilityReason = 'Sequence already completed';\n  }\n\n  lead.isEligible = isEligible;\n  lead.eligibilityReason = eligibilityReason;\n\n  return item;\n});"
      },
